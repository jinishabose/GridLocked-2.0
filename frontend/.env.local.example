# GridLocked — Environment Variables
# Copy this file to .env.local and fill in your values

# Mappls Map API Key (get from https://auth.mappls.com/console)
# Without this key, the platform uses the canvas-based map preview
NEXT_PUBLIC_MAPPLS_API_KEY=8eec3a1829791fefffb1896e05314330

# Backend API URL (if running FastAPI separately)
NEXT_PUBLIC_API_URL=http://localhost:8000
